# Copy to .env.local. Values are embedded in client bundles: never put secrets here.
# Use YOUR private Tailscale server address for paired-device access.
# Leave empty for an unconfigured local preview.
EXPO_PUBLIC_HISTORY_URL=
EXPO_PUBLIC_GYMS="Home gym|Local gym"
# Optional private Metro forwarding (node --env-file=.env.local scripts/phone-preview.mjs)
PHONE_PREVIEW_DEVICE=
PHONE_PREVIEW_BIND=
